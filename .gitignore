# Never commit data (PROJECT.md section 10). Includes frames pasted into figures/.
data/raw/
data/processed/
*.npy
*.memmap
*.lmdb
*.jpg
*.jpeg
*.png
*.gif
*.mp4
!figures/.gitkeep
runs/*/checkpoints/
__pycache__/
*.pyc
.pytest_cache/
venv/
.DS_Store

# Generated outputs. A dated snapshot of stats.txt lives in docs/ instead.
stats.txt
artifacts_2017/
data/processed/

# Model weights and run outputs. The repo is the deliverable and is read by a grader, so it
# must stay small:  alone is 89 MB of checkpoints and the working tree carries 2.4 GB
# of untracked artifacts. Results reach the repo as the summary tables under docs/, never as
# the runs themselves.
*.pt
*.pth
*.ckpt
runs/
runs_*/
lab/
lab_snapshot/
logs/
logs_*/
*.log
data/raw_2017/
__pycache__/

# Generated by scripts/power_results.py; the committed copies live under docs/.
results/

# HDD (Honda) data and anything derived from it: licence §4.b, never in this public repo.
# Derived outputs (features, block assignments, GPS tracks, per-session tables, overlay clips)
# live on the server under ~/workspace/hdd/ only.
hdd_data/
data/hdd*/
data/processed_hdd*/
*.npz
*.h5
*.hdf5
*.parquet
*.feather
*.webm
*.mov
*.avi
*.mkv
*.m4v
# Scripts in hdd/ must write to ~/workspace/hdd/; catch outputs that land next to them by mistake.
hdd/**/*.csv
hdd/**/*.json
# More HDD-derived formats: split files, pickled or zarr feature caches, per-session tables.
splits/
*.pkl
*.pickle
*.zarr/
*.safetensors
sessions.csv
summary.json
*hdd*.csv
*hdd*.json
